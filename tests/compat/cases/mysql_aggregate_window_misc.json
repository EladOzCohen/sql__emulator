  {
    "id": "mysql-aggwin-005",
    "function": "LAG",
    "sql": "WITH series AS (SELECT '12:00:00' AS t, 100 AS val UNION ALL SELECT '13:00:00',125 UNION ALL SELECT '14:00:00',132 UNION ALL SELECT '15:00:00',145 UNION ALL SELECT '16:00:00',140 UNION ALL SELECT '17:00:00',150 UNION ALL SELECT '18:00:00',200) SELECT t, val, LAG(val) OVER w AS 'lag', LEAD(val) OVER w AS 'lead', val - LAG(val) OVER w AS 'lag diff', val - LEAD(val) OVER w AS 'lead diff' FROM series WINDOW w AS (ORDER BY t);",
    "expected_rows": [
      [
        "12:00:00",
        "100",
        "NULL",
        "125",
        "NULL",
        "-25"
      ],
      [
        "13:00:00",
        "125",
        "100",
        "132",
        "25",
        "-7"
