        "132",
        "125",
        "145",
        "7",
        "-13"
      ],
      [
        "15:00:00",
        "145",
        "132",
        "140",
        "13",
        "5"
      ],
      [
        "16:00:00",
        "140",
        "145",
        "150",
        "-5",
        "-10"
      ],
      [
        "17:00:00",
        "150",
        "140",
