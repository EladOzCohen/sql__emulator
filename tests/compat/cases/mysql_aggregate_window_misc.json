    "sql": "WITH observations AS (SELECT '07:00:00' AS time, 'st113' AS subject, 10 AS val UNION ALL SELECT '07:15:00','st113',9 UNION ALL SELECT '07:30:00','st113',25 UNION ALL SELECT '07:45:00','st113',20 UNION ALL SELECT '07:00:00','xh458',0 UNION ALL SELECT '07:15:00','xh458',10 UNION ALL SELECT '07:30:00','xh458',5 UNION ALL SELECT '07:45:00','xh458',30 UNION ALL SELECT '08:00:00','xh458',25) SELECT time, subject, val, FIRST_VALUE(val) OVER w AS 'first', LAST_VALUE(val) OVER w AS 'last', NTH_VALUE(val, 2) OVER w AS 'second', NTH_VALUE(val, 4) OVER w AS 'fourth' FROM observations WINDOW w AS (PARTITION BY subject ORDER BY time ROWS UNBOUNDED PRECEDING);",
