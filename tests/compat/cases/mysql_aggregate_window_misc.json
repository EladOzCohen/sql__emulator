[
  {
    "id": "mysql-aggwin-001",
    "function": "JSON_ARRAYAGG",
    "sql": "WITH t3 AS (SELECT 2 AS o_id, 'color' AS attribute, 'red' AS value UNION ALL SELECT 2, 'fabric', 'silk' UNION ALL SELECT 3, 'color', 'green' UNION ALL SELECT 3, 'shape', 'square') SELECT o_id, JSON_ARRAYAGG(attribute) AS attributes FROM t3 GROUP BY o_id;",
    "expected_rows": [
      [
        "2",
        "[\"color\", \"fabric\"]"
      ],
      [
        "3",
        "[\"color\", \"shape\"]"
      ]
    ],
    "source": "https://dev.mysql.com/doc/refman/8.4/en/aggregate-functions.html#JSON_ARRAYAGG",
    "notes": "t3 CTE reconstructed from the manual's shown table (o_id, attribute, value); row/array element order as shown by manual, not guaranteed by MySQL"
  },
  {
    "id": "mysql-aggwin-002",
    "function": "JSON_OBJECTAGG",
    "sql": "WITH t3 AS (SELECT 2 AS o_id, 'color' AS attribute, 'red' AS value UNION ALL SELECT 2, 'fabric', 'silk' UNION ALL SELECT 3, 'color', 'green' UNION ALL SELECT 3, 'shape', 'square') SELECT o_id, JSON_OBJECTAGG(attribute, value) FROM t3 GROUP BY o_id;",
    "expected_rows": [
      [
        "2",
        "{\"color\": \"red\", \"fabric\": \"silk\"}"
      ],
      [
        "3",
        "{\"color\": \"green\", \"shape\": \"square\"}"
      ]
    ],
    "source": "https://dev.mysql.com/doc/refman/8.4/en/aggregate-functions.html#JSON_OBJECTAGG",
    "notes": "t3 CTE reconstructed from the manual's shown table; row order as shown by manual"
  },
