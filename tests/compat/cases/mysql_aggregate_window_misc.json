      ],
      [
        "18:00:00",
        "200",
        "150",
        "NULL",
        "50",
        "NULL"
      ]
    ],
    "source": "https://dev.mysql.com/doc/refman/8.4/en/window-function-descriptions.html#LAG",
    "notes": "series CTE reconstructed from the manual's output (manual does not define the table); also covers LEAD"
  },
