  "id": "bq-array-039",
  "function": "GENERATE_DATE_ARRAY",
  "sql": "SELECT GENERATE_DATE_ARRAY(date_start, date_end, INTERVAL 1 WEEK) AS date_range\nFROM (\n  SELECT DATE '2016-01-01' AS date_start, DATE '2016-01-31' AS date_end\n  UNION ALL SELECT DATE \"2016-04-01\", DATE \"2016-04-30\"\n  UNION ALL SELECT DATE \"2016-07-01\", DATE \"2016-07-31\"\n  UNION ALL SELECT DATE \"2016-10-01\", DATE \"2016-10-31\"\n) AS items;",
  "expected_rows": [
   [
    "[2016-01-01, 2016-01-08, 2016-01-15, 2016-01-22, 2016-01-29]"
   ],
   [
    "[2016-04-01, 2016-04-08, 2016-04-15, 2016-04-22, 2016-04-29]"
   ],
   [
    "[2016-07-01, 2016-07-08, 2016-07-15, 2016-07-22, 2016-07-29]"
   ],
   [
    "[2016-10-01, 2016-10-08, 2016-10-15, 2016-10-22, 2016-10-29]"
   ]
  ],
  "expected_columns": [
   "date_range"
  ],
  "source": "https://cloud.google.com/bigquery/docs/reference/standard-sql/array_functions#generate_date_array",
  "notes": "Row order not guaranteed by the SQL (no top-level ORDER BY); compare unordered."
 },
